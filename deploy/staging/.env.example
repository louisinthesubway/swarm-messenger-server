# SWARM Messenger — staging stack environment TEMPLATE.
#
#   cp .env.example .env     # then fill in every REPLACE_ME
#
# .env is git-ignored. Docker Compose reads it automatically from this directory.
# Values here are not secrets in the cryptographic sense, but the MinIO passwords are
# credentials: keep the file 600 and off shared drives.

# ---------------------------------------------------------------- the staging kill switch
# Must be exactly "true" or NOTHING starts: the chat server refuses to build a
# `swarm-staging` registration client and the registration stub exits 78.
# Never set this in a production profile.
SWARM_STAGING_FIXED_CODE=true

# The one verification code the stub issues and accepts, for every phone number.
SWARM_STAGING_VERIFICATION_CODE=123456

# ---------------------------------------------------------------- public names
SWARM_CHAT_DOMAIN=chat.swarm.green
SWARM_CDN_DOMAIN=cdn.chat.swarm.green
SWARM_REG_DOMAIN=reg.chat.swarm.green
SWARM_SFU_DOMAIN=sfu.chat.swarm.green
# Where Let's Encrypt sends expiry warnings.
SWARM_ACME_EMAIL=REPLACE_ME

# ---------------------------------------------------------------- storage credentials
# These must match aws.accessKeyId / aws.secretAccessKey in staging-secrets.yml.
SWARM_AWS_REGION=us-east-1
SWARM_AWS_ACCESS_KEY_ID=REPLACE_ME
SWARM_AWS_SECRET_ACCESS_KEY=REPLACE_ME

# MinIO root account (console + `mc`). Not the account the chat server uses.
SWARM_MINIO_ROOT_USER=swarmstaging
SWARM_MINIO_ROOT_PASSWORD=REPLACE_ME

# Scoped MinIO account for the CDN bucket only. Must match cdn.accessKey /
# cdn.accessSecret in staging-secrets.yml.
SWARM_CDN_ACCESS_KEY=swarmcdn
SWARM_CDN_SECRET_KEY=REPLACE_ME

# ---------------------------------------------------------------- generated public values
# The PEM of certs/swarm-staging-ca.crt as a SINGLE LINE with literal \n escapes.
# staging.yml quotes it, and a double-quoted YAML scalar turns \n back into newlines.
# generate-secrets.sh writes this line for you; make-certs.sh prints it.
SWARM_REGISTRATION_CA_PEM=REPLACE_ME

# Public half of groupsZkConfig.serverSecret. Printed as "Public:" by the server's
# `zkparams` command. Must pair with the secret in staging-secrets.yml.
SWARM_GROUPS_ZK_SERVER_PUBLIC=REPLACE_ME

# Sealed-sender server certificate, base64. Produced by the server's
# `certificate --key <unidentifiedDelivery.privateKey> --id <n>` command.
SWARM_UNIDENTIFIED_DELIVERY_CERTIFICATE=REPLACE_ME

# ---------------------------------------------------------------- tuning (defaults are fine)
SWARM_LOG_LEVEL=INFO
SWARM_TABLE_PREFIX=swarm_
SWARM_CDN_BUCKET=swarm-cdn
SWARM_PREKEY_BUCKET=swarm-prekeys
SWARM_CONFIG_BUCKET=swarm-config
