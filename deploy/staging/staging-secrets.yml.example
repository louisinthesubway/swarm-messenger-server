# SWARM Messenger — staging secrets bundle TEMPLATE.
#
#   cp staging-secrets.yml.example staging-secrets.yml     # then fill it in
#   ./generate-secrets.sh                                  # or let this script do it for you
#
# staging-secrets.yml is git-ignored. NOTHING in this file is a real secret: every value is
# either "REPLACE_ME" or a placeholder for a feature that is switched off.
#
# The server reads this file through -Dsecrets.bundle.filename (see ../Dockerfile) and
# resolves `secret://key` references in staging.yml against it. Keys use dots, exactly as
# written in staging.yml.
#
# WHICH VALUES ACTUALLY MATTER
# ------------------------------------------------------------------------------------------
# Real, must be generated for this deployment (generate-secrets.sh does all of these):
#
#   aws.accessKeyId / aws.secretAccessKey          MinIO + DynamoDB Local credentials
#   cdn.accessKey / cdn.accessSecret               the scoped MinIO key for the CDN bucket
#   groupsZkConfig.serverSecret                    `zkparams` — pairs with SWARM_GROUPS_ZK_SERVER_PUBLIC
#   chatZkConfig.serverSecret                      `zkparams`
#   callingZkConfigV101.serverSecret               `zkparams`
#   callingZkConfigPreV101.serverSecret            `zkparams`
#   unidentifiedDelivery.privateKey                `certificate --ca` — the sealed-sender trust root
#   foundationDbMessages.versionstampCipherKey.0   32 random bytes, base64
#   registrationService.collationKeySalt           random bytes, base64
#   registrationWebAuthn.userHandleBlindingSecret  32 random bytes, base64
#   linkDevice.secret                              32 random bytes, base64
#   storageService.userAuthenticationTokenSharedSecret   32 random bytes, base64
#   paymentsService.userAuthenticationTokenSharedSecret  32 random bytes, base64
#   directoryV2 / svr2 / svrb / tus shared secrets random bytes, base64 (features are off, but
#                                                  the tokens the server hands clients are
#                                                  derived from them, so give them real values)
#   tlsKeyStore.password                           only used if you make the JVM terminate TLS
#
# Placeholders for features that are off and cannot be turned on in this stack (billing,
# push, key transparency, GCP attachments, Cloudflare TURN, currency conversion): the values
# only have to parse. The ones below are upstream's own published test values, copied from
# service/src/test/resources/config/test-secrets-bundle.yml, so the server starts.
#
# LOSING THESE VALUES
# ------------------------------------------------------------------------------------------
# unidentifiedDelivery.privateKey and the four zk secrets are baked into what clients have
# already been told. Rotating them invalidates existing sealed-sender certificates and
# zk credentials: every client must be updated. Back them up off the host.

# ---------------------------------------------------------------- real: storage credentials
aws.accessKeyId: REPLACE_ME
aws.secretAccessKey: REPLACE_ME

cdn.accessKey: REPLACE_ME
cdn.accessSecret: REPLACE_ME

# ---------------------------------------------------------------- real: zk and sealed sender
# Generate with the server's own commands (see generate-secrets.sh):
#   java -Dsecrets.bundle.filename=staging-secrets.yml -jar <jar> zkparams
#   java -Dsecrets.bundle.filename=staging-secrets.yml -jar <jar> certificate --ca
groupsZkConfig.serverSecret: REPLACE_ME_ZKPARAMS_PRIVATE
chatZkConfig.serverSecret: REPLACE_ME_ZKPARAMS_PRIVATE
callingZkConfigV101.serverSecret: REPLACE_ME_ZKPARAMS_PRIVATE
callingZkConfigPreV101.serverSecret: REPLACE_ME_ZKPARAMS_PRIVATE

# The private half of the sealed-sender trust root. The SWARM Messenger clients must ship the
# matching public half as their serverTrustRoot, and staging.yml's
# unidentifiedDelivery.certificate must be a certificate signed by this key.
unidentifiedDelivery.privateKey: REPLACE_ME_BASE64_32_BYTES

# ---------------------------------------------------------------- real: random shared secrets
# Every one of these is base64 of 32 random bytes.
foundationDbMessages.versionstampCipherKey.0: REPLACE_ME_BASE64_32_BYTES
registrationService.collationKeySalt: REPLACE_ME_BASE64_32_BYTES
registrationWebAuthn.userHandleBlindingSecret: REPLACE_ME_BASE64_32_BYTES
linkDevice.secret: REPLACE_ME_BASE64_32_BYTES
storageService.userAuthenticationTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES
paymentsService.userAuthenticationTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES
directoryV2.client.userAuthenticationTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES
directoryV2.client.userIdTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES
svr2.userAuthenticationTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES
svr2.userIdTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES
svrb.userAuthenticationTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES
svrb.userIdTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES
tus.userAuthenticationTokenSharedSecret: REPLACE_ME_BASE64_32_BYTES

tlsKeyStore.password: REPLACE_ME

# ---------------------------------------------------------------- placeholders: billing (off)
stripe.apiKey: unset
stripe.idempotencyKeyGenerator: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
braintree.publicKey: unset
braintree.privateKey: unset

# Upstream's published throwaway EC test key (test-secrets-bundle.yml). App Store
# subscriptions are off; this only has to parse.
appleAppStore.encodedKey: |
  -----BEGIN PRIVATE KEY-----
  MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgF32wH6zG3GFMBs38
  pOp712zI2NBwnccdfwxI6lidSkShRANCAATUzzM68ATLZ+TD09nT03ZyxjY1MA7H
  dCuKcyQAVQo+X5lc8TpMgTWg36Kzxb4hPU1cqshIJomI0iE70eLOUe8p
  -----END PRIVATE KEY-----

# ---------------------------------------------------------------- placeholders: push (off)
apn.teamId: disabled
apn.keyId: disabled
# Upstream's published throwaway EC test key. APNs is off.
apn.signingKey: |
  -----BEGIN PRIVATE KEY-----
  MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgxIXnNiHH35DDbKHY
  8kxoAYbukvMPVWN+kiIhZsFvqaahRANCAAQTWXjgagaLnTxcMJTUpO3rkhi8xjav
  7NSEd5L+df4M7V9YxxDoYY+UHd8B/KmrWR29SVIRLncSULgfSnHnHvoH
  -----END PRIVATE KEY-----

# FirebaseMessaging is constructed at startup, so this must be a parseable service-account
# JSON. It points at nothing. FCM is off.
fcm.credentials: |
  { "type": "service_account", "client_id": "disabled", "client_email": "disabled@swarm.invalid",
    "private_key_id": "disabled",
    "private_key": "-----BEGIN PRIVATE KEY-----
  REPLACE_ME_WITH_A_THROWAWAY_RSA_KEY_SEE_GENERATE_SECRETS_SH
  -----END PRIVATE KEY-----" }

# ---------------------------------------------------------------- placeholders: other (off)
# Upstream's published throwaway RSA key. GCP-signed attachment URLs are off.
gcpAttachments.rsaSigningKey: |
  -----BEGIN PRIVATE KEY-----
  REPLACE_ME_WITH_A_THROWAWAY_RSA_KEY_SEE_GENERATE_SECRETS_SH
  -----END PRIVATE KEY-----

# Upstream's published throwaway EC test key. Key transparency is off.
keyTransparencyService.clientPrivateKey: |
  -----BEGIN PRIVATE KEY-----
  MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgxIXnNiHH35DDbKHY
  8kxoAYbukvMPVWN+kiIhZsFvqaahRANCAAQTWXjgagaLnTxcMJTUpO3rkhi8xjav
  7NSEd5L+df4M7V9YxxDoYY+UHd8B/KmrWR29SVIRLncSULgfSnHnHvoH
  -----END PRIVATE KEY-----

cdn3StorageManager.clientSecret: unset
turn.cloudflare.apiToken: unset
paymentsService.fixerApiKey: unset
paymentsService.coinGeckoApiKey: unset
hlrLookup.apiKey: unset
hlrLookup.apiSecret: unset
