# SWARM Messenger staging — never commit the filled-in versions of these.
#
# Committed: *.example templates, the compose file, the scripts, staging.yml.
# Generated on the host by generate-secrets.sh and certs/make-certs.sh: everything below.

.env
staging-secrets.yml

# Public, but deployment-specific: regenerated on every host, handed to the client builds by
# hand rather than committed. See docs/STAGING.md ("Public parameters for the clients").
shared/

certs/*.key
certs/*.crt
certs/*.csr
certs/*.srl
certs/*.ext
certs/*.pem

# Python bytecode from running the stub outside its container.
__pycache__/
*.pyc

# Staged by prepare-image.sh: the jar and the FoundationDB client library the chat image copies.
build/
