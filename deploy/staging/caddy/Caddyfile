# SWARM Messenger — staging TLS edge.
#
# Start with:  docker compose --profile edge up -d caddy
#
# Caddy gets certificates for the three public names from Let's Encrypt automatically, which
# requires ports 80 and 443 reachable from the internet and the A/AAAA records already
# pointing at this host. See docs/STAGING.md ("DNS") before starting it.
#
# The chat server speaks cleartext HTTP/2 (h2c) on 8080 inside the compose network, so the
# plain API route uses `transport http { versions h2c 2 }`. The websocket route must NOT: Go's
# HTTP/2 client (which Caddy uses for h2c upstreams) refuses any request carrying an Upgrade
# header ("http2: invalid Upgrade request header"), so every /v1/websocket handshake came back
# as 502 (found 2026-09-27 with the first live edge). Jetty's h2c connector also speaks plain
# HTTP/1.1, and an HTTP/1.1 websocket upgrade to chat:8080 answers 101, so that route pins 1.1.
#
# libsignal's HTTP/2 chat connection (swarm-libsignal 0.101.2-swarm.2 and later) opens the same
# websocket as an RFC 8441 extended CONNECT and sends gRPC on that connection. Caddy advertises
# extended CONNECT only because docker-compose.yml runs it with GODEBUG=http2xconnect=1 (Go's
# HTTP/2 server keeps it off otherwise); its reverse proxy turns such a websocket into the same
# HTTP/1.1 upgrade toward chat:8080. gRPC (Content-Type application/grpc) goes to the server's
# omnibus listener chat:50051 over h2c, with PROXY protocol v2 so the server sees the client's
# address. See docs/STAGING.md, section 5b.
#
# The alternative is to skip Caddy entirely and let the JVM terminate TLS: replace the `h2c`
# application connector in staging.yml with an `h2` connector and point tlsKeyStore at a
# PKCS#12 keystore. Caddy is the default because renewals are then somebody else's problem.

{
	email {$SWARM_ACME_EMAIL}
	# Uncomment while testing DNS or rate limits, then comment it out again — a staging
	# certificate is not trusted by clients.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

# ------------------------------------------------------------------ chat API + websocket
{$SWARM_CHAT_DOMAIN} {
	encode zstd gzip

	# The websocket endpoints clients use to send and receive messages.
	@websocket path /v1/websocket /v1/websocket/*
	handle @websocket {
		reverse_proxy chat:8080 {
			transport http {
				# HTTP/1.1 only: websocket upgrades cannot travel over h2c (see the note at the top).
				versions 1.1
			}
			# Message delivery holds the socket open indefinitely.
			flush_interval -1
		}
	}

	# gRPC on libsignal's HTTP/2 chat connection: usernames, devices, backups and the other
	# calls libsignal only makes over gRPC. The omnibus listener routes every path except the
	# websocket ones to the server's in-process gRPC services; the Authorization header (HTTP
	# Basic, as on the websocket) passes through untouched. 50051 is not published on the host.
	@grpc protocol grpc
	handle @grpc {
		reverse_proxy chat:50051 {
			transport http {
				versions h2c 2
				# The omnibus reads the client address from a PROXY v2 header (upstream puts a
				# PPv2 load balancer in front of it). Caddy opens one upstream connection per
				# request when this is on.
				proxy_protocol v2
			}
		}
	}

	handle {
		reverse_proxy chat:8080 {
			transport http {
				versions h2c 2
			}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# The Dropwizard admin connector carries health checks and metrics. It is NOT published.
	@admin path /healthcheck /metrics /metrics/*
	handle @admin {
		respond "not found" 404
	}

	log {
		output stdout
		format console
	}
}

# ------------------------------------------------------------------ attachments / CDN
# Objects live in the MinIO bucket swarm-cdn; clients never see the bucket name. Contract and
# runbook: docs/STAGING.md, section 8a.
#
#   POST PATCH HEAD OPTIONS  /upload/attachments[/<key>]   CDN3 (TUS) attachment uploads -> tus,
#                                                          which checks the chat server's upload
#                                                          token on every request
#   POST multipart/form-data /                             CDN0 avatar uploads (an S3 POST
#                                                          policy) -> MinIO, which checks the
#                                                          policy's signature
#   GET HEAD                 /attachments/*, /profiles/*   anonymous reads -> MinIO; the bucket
#                                                          policy allows GetObject on exactly
#                                                          these two prefixes
#
# Nothing else gets through. No `encode`: every object is ciphertext, which does not compress, and
# the desktop refuses an attachment download without Content-Length, which the encoder drops.
{$SWARM_CDN_DOMAIN} {
	@tus {
		path /upload/attachments /upload/attachments/*
		method POST PATCH HEAD OPTIONS
	}
	handle @tus {
		request_body {
			# attachments.maxAttachmentUploadSizeInBytes is 100 MiB; the service enforces the
			# exact limit from the token.
			max_size 105MB
		}
		reverse_proxy tus:1080
	}

	@avatarUpload {
		method POST
		path /
		header Content-Type multipart/form-data*
	}
	handle @avatarUpload {
		request_body {
			# ProfileHelper.MAX_PROFILE_AVATAR_SIZE_BYTES is 10 MiB, plus the form fields.
			max_size 11MB
		}
		rewrite * /swarm-cdn
		reverse_proxy minio:9000
	}

	@read {
		method GET HEAD
		path /attachments/* /profiles/*
	}
	handle @read {
		# {path}, not {uri}: no query string reaches MinIO, so no S3 sub-resources either.
		rewrite * /swarm-cdn{path}
		reverse_proxy minio:9000
	}

	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format console
	}
}

# ------------------------------------------------------------------ registration
# reg.chat.swarm.green is deliberately NOT proxied to the registration stub. The stub speaks
# gRPC over its own TLS with a private CA and is reachable only from the chat container on the
# compose network. Publishing it would expose a service that accepts one fixed code for every
# phone number. The name is answered so that a misconfigured client fails loudly.
{$SWARM_REG_DOMAIN:reg.chat.swarm.green} {
	respond "SWARM Messenger staging: the registration service is not published. Clients register through {$SWARM_CHAT_DOMAIN}." 404

	log {
		output stdout
		format console
	}
}
